# Get your public token from Mapbox dashboard
# Then copy this file, name it as .env.local
NEXT_PUBLIC_MAPBOX_TOKEN=''

# Google Tag Manager tracking code
# Not required unless you are actively developing
GOOGLE_TAG_MANAGER_ID=''
GOOGLE_TAG_AUTH=''
GOOGLE_TAG_PREVIEW=''

# Optional subpath the site is served under (defaults to "waterinsight").
# Set to an empty string to serve from the root.
# NEXT_PUBLIC_SUBPATH='waterinsight'
